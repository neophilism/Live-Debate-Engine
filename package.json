{
  "name": "live-debate-engine",
  "version": "0.0.0-foundation.2",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.16.0 || ^24.0.0" },
  "workspaces": ["apps/*", "packages/*"],
  "files": ["dist", "database/migrations", "docs", "README.md", "SECURITY.md"],
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint apps packages scripts tests",
    "check:plan": "node scripts/check-plan.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test": "node --test tests/plan.test.mjs tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "check": "npm run check:plan && npm run typecheck && npm run lint && npm run build && npm run check:migrations && npm test",
    "dev": "npm run build && node --env-file-if-exists=.env dist/apps/api/src/main.js",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/main.js",
    "migrate": "node --env-file-if-exists=.env dist/scripts/migrate.js",
    "artifacts": "node scripts/artifacts.mjs"
  },
  "dependencies": { "better-auth": "1.7.7", "pg": "8.16.3" },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/node": "22.15.18",
    "@types/pg": "8.15.5",
    "typescript": "5.8.3"
  }
}
