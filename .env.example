# Reference only. setup:local creates private .env and .env.migrations files.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LDE_ALLOW_INSECURE_LOCAL_DB=0
DATABASE_URL=
LDE_IDENTITY_ENABLED=0
LDE_IDENTITY_DATABASE_URL=
LDE_IDENTITY_ORIGIN=
LDE_IDENTITY_SECRET=
# local-file is loopback development only; resend needs a verified sending account.
LDE_IDENTITY_MAIL_MODE=
LDE_IDENTITY_MAIL_FROM=
RESEND_API_KEY=
# DATABASE_URL_UNPOOLED belongs only in the separate operator/migration environment.
# Never commit credentials or copy migration credentials into the serving process.

# Optional protected storage. Generate private keys outside Git before enabling.
# LDE_STORAGE_KEY_FILE=/absolute/private/path/lde-storage-keys.json
# Scanner process only (never put its credential in the browser):
# LDE_CLAMAV_SOCKET=/run/clamav/clamd.sock
