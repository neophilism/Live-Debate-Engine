{
  "name": "live-debate-engine",
  "version": "0.0.0-foundation.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.16.0 || ^24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "files": [
    "dist",
    "database/migrations",
    "docs",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint apps packages scripts tests",
    "check:plan": "node scripts/check-plan.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test": "node --test tests/plan.test.mjs tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "check": "npm run check:plan && npm run typecheck && npm run lint && npm run build && npm run check:migrations && npm test",
    "dev": "npm run build && node --env-file-if-exists=.env dist/apps/api/src/main.js",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/main.js",
    "migrate": "node --env-file-if-exists=.env.migrations dist/scripts/migrate.js",
    "artifacts": "node scripts/artifacts.mjs",
    "provision:local": "node --env-file=.env --env-file=.env.migrations dist/scripts/provision-local.js",
    "access:admin": "node --env-file-if-exists=.env.migrations dist/scripts/access-admin.js",
    "test:browser": "node --test tests/browser/*.test.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "kysely": "0.29.6",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@types/bun": "1.3.14",
    "@types/node": "22.15.18",
    "@types/pg": "8.15.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "typescript": "5.8.3"
  }
}
